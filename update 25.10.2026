    { slug: 'pomidorowy', name: 'Sos pomidorowo-ziołowy (80ml)', price: 4 },
    { slug: 'ostry_jalapeno', name: 'Sos ostry Jalapeño / Sriracha (80ml)', price: 5 },
    { slug: 'miodowo_musztardowy', name: 'Sos miodowo-musztardowy (80ml)', price: 4 },
