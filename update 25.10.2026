          </div>

          <div class="form-grid-street">
            <div class="field-group">
              <label for="inputDiscordWebhookUrl">ADRES URL WEBHOOKA KANAŁU DISCORD (NP. https://discord.com/api/webhooks/ID/TOKEN)</label>
              <input type="url" id="inputDiscordWebhookUrl" placeholder="https://discord.com/api/webhooks/..." />
            </div>
            <div class="field-group" style="justify-content: flex-end; gap: 8px; flex-direction: row; align-items: flex-end;">
              <button type="button" class="submit-order-btn" id="saveDiscordWebhookBtn" style="margin-bottom: 0; background-color: #1d231a; color: #ffffff;">
                💾 ZAPISZ URL
              </button>
              <button type="button" class="submit-order-btn" id="testDiscordWebhookBtn" style="margin-bottom: 0;">
                🔔 WYŚLIJ TEST NA DISCORD
              </button>
            </div>
          </div>

          <div id="discordLogsContainer" style="font-size: 12px; color: #2c2b26; background: #f2efe6; padding: 12px; border-radius: 10px;">
            Ostatnie powiadomienia Discord Webhook pojawią się tutaj automatycznie po złożeniu zamówienia lub zmianie jego statusu.
          </div>
        </section>

        <!-- SEKCJA 2: ZARZĄDZANIE ZAMÓWIENIAMI I STATUSAMI -->
        <section class="step-card">
          <div class="step-header">
            <div class="step-header-left">
              <span class="step-number">02</span>
              <h2 class="step-title">OBSŁUGA ZAMÓWIEŃ I ZMIANA STATUSÓW</h2>
            </div>
          </div>
          <div style="overflow-x: auto;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>NR ZAMÓWIENIA</th>
                  <th>KLIENT / ODBIÓR</th>
                  <th>POZYCJE</th>
                  <th>PŁATNOŚĆ</th>
                  <th>KWOTA</th>
                  <th>STATUS ZAMÓWIENIA (ZMIEŃ NA ŻYWO)</th>
                </tr>
              </thead>
              <tbody id="adminOrdersTableBody"></tbody>
            </table>
          </div>
        </section>

        <!-- SEKCJA 3: ZARZĄDZANIE MENU I CENAMI -->
        <div class="checkout-layout">
          <section class="step-card">
            <div class="step-header">
              <div class="step-header-left">
                <span class="step-number">03</span>
                <h2 class="step-title">EDYCJA CEN I DOSTĘPNOŚCI MENU</h2>
              </div>
            </div>
            <div style="overflow-x: auto;">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>DANIE</th>
                    <th>KATEGORIA</th>
                    <th>CENA (ZŁ)</th>
                    <th>DOSTĘPNOŚĆ</th>
                    <th>AKCJA</th>
                  </tr>
                </thead>
                <tbody id="adminMenuTableBody"></tbody>
              </table>
            </div>
          </section>

          <section class="step-card">
            <div class="step-header">
              <div class="step-header-left">
                <span class="step-number">04</span>
                <h2 class="step-title">DODAJ NOWĄ POZYCJĘ DO MENU</h2>
              </div>
            </div>
            <form id="adminAddProductForm">
              <div class="field-group">
                <label>KATEGORIA</label>
                <select id="adminProdCategory">
                  <option value="PIZZA">PIZZA</option>
                  <option value="BURGERY">BURGERY</option>
                  <option value="PASTA">PASTA</option>
                  <option value="SALATKI">SAŁATKI</option>
                  <option value="NAPOJE">NAPOJE</option>
                </select>
              </div>
              <div class="field-group">
                <label>NAZWA DANIA</label>
                <input type="text" id="adminProdName" placeholder="np. Pizza Kaszubska" required />
              </div>
              <div class="form-grid-2">
                <div class="field-group">
                  <label>CENA (ZŁ)</label>
                  <input type="number" id="adminProdPrice" placeholder="44" required />
                </div>
                <div class="field-group">
                  <label>ZNACZNIK (BADGE)</label>
                  <input type="text" id="adminProdBadge" placeholder="NOWOŚĆ / OSTRA / VEGE" />
                </div>
              </div>
              <div class="field-group">
                <label>SKŁADNIKI / OPIS</label>
                <textarea id="adminProdDesc" placeholder="sos pomidorowy, mozzarella, borowiki..." required></textarea>
              </div>
              <button type="submit" class="submit-order-btn">+ DODAJ DO KARTY DAŃ</button>
            </form>
          </section>
        </div>
      </main>
