          </div>

          <!-- KROK 02: WARIANT CIASTA -->
          <div class="config-section-block">
            <div class="config-sec-title">
              <h3>02. WYBIERZ WARIANT CIASTA</h3>
              <span class="config-sec-req">WYMAGANE · 1 OPCJA</span>
            </div>
            <div class="dough-options-grid" id="cfgDoughOptionsContainer"></div>
          </div>

          <!-- KROK 03: SOSY DO PIZZY -->
          <div class="config-section-block">
            <div class="config-sec-title">
              <h3>03. DOBIERZ SOSY I OLIWY DO PIZZY</h3>
              <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">OPCJONALNIE · DOWOLNA ILOŚĆ</span>
            </div>
            <div class="sauces-grid" id="cfgSaucesOptionsContainer"></div>
          </div>

          <!-- KROK 04: DODATKOWE SKŁADNIKI -->
          <div class="config-section-block">
            <div class="config-sec-title">
              <h3>04. DODATKOWE SKŁADNIKI NA PIZZĘ</h3>
              <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">OPCJONALNIE · PERSONALIZACJA</span>
            </div>
            <div class="sauces-grid" id="cfgExtrasOptionsContainer"></div>
          </div>
        </div>

        <!-- Stopka konfiguratora z wyborem ilości i dynamicznym przelicznikiem ceny -->
        <div class="config-modal-footer">
          <div class="config-qty-picker">
            <button type="button" id="cfgQtyDecBtn">−</button>
            <strong id="cfgQtyValue" style="font-size: 16px;">1</strong>
            <button type="button" id="cfgQtyIncBtn">+</button>
          </div>

          <button type="button" class="config-add-confirm-btn" id="cfgAddToCartConfirmBtn">
            <span>DODAJ DO KOSZYKA</span>
            <span id="cfgLiveTotalPrice" style="font-family: var(--font-display); font-size: 22px;">39 zł →</span>
          </button>
        </div>
      </div>
    </div>

    <!-- PŁYWAJĄCY DOLNY PASEK KOSZYKA DLA TELEFONÓW -->
    <div class="mobile-floating-cart visible-on-mobile" id="mobileFloatingCartBar">
      <div>
        <div style="font-size: 10px; color: #d5dcd0;" id="mfcCountLabel">1 POZYCJA W KOSZYKU</div>
        <div style="font-family: var(--font-display); font-size: 26px; font-weight: 800; color: var(--accent-lime);" id="mfcTotalValue">39 zł</div>
      </div>
      <button type="button" class="util-btn active" id="mfcGoToCheckoutBtn" style="padding: 12px 20px; font-size: 12px;">
        DO KASY →
      </button>
    </div>

    <!-- STOPKA -->
    <footer class="footer">
      <div class="brand-logo" style="color: #ffffff;">
        <div class="brand-circle">b</div>
        <span class="brand-text">BEMOL</span>
      </div>
      <div class="footer-links">
        <span>Menu</span>
        <span>O nas</span>
        <span>Kontakt</span>
      </div>
      <div>© 2026 BEMOL</div>
    </footer>

  </div>

  <!-- Leaflet JS dla interaktywnej mapy strefy dostawy -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="app-v10.js"></script>
</body>
</html>

