  <!-- Leaflet JS dla interaktywnej mapy strefy dostawy -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
// ============================================================================
// PLIK: frontend/app-v10.js
// Kompletna logika Systemu Zamówień Pizzerii BEMOL (Kartuzy) - Wersja v5
// Zawiera: Konfigurator Wariantów Ciasta, Rozmiarów Pizzy (32 cm / 42 cm) i Sosów,
// Mapę Stref Dostawy, Płatności BLIK/Karta, JWT, Historię Zamówień i Discord Webhook
// ============================================================================

const BEMOL_CENTER = { lat: 54.3344, lng: 18.2014 }; // ul. Kościuszki 19, 83-300 Kartuzy

const INITIAL_DATA = {
  categories: [
    { slug: 'PIZZA', name: 'PIZZA', hasConfigurator: true },
    { slug: 'BURGERY', name: 'BURGERY', hasConfigurator: false },
