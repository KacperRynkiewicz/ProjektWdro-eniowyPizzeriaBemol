    <div class="modal-overlay hidden" id="pizzaConfiguratorModal">
      <div class="pizza-config-modal-box">
        <!-- Nagłówek z podglądem wybranej pizzy -->
        <div class="config-modal-header">
          <img src="" alt="Wybrana pizza" id="cfgPizzaImage" />
          <div>
            <span class="status-pill done" id="cfgPizzaBadge">KONFIGURATOR PIZZY BEMOL</span>
