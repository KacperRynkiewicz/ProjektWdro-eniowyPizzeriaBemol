                  <input type="tel" id="inputPhone" placeholder="+48 000 000 000" required />
                </div>
              </div>

              <div class="field-group">
                <label for="inputEmail">E-MAIL</label>
                <input type="email" id="inputEmail" placeholder="adres@email.pl" required />
              </div>
            </section>

            <!-- KROK 03: ADRES DOSTAWY + INTERAKTYWNA MAPA I SPRAWDZANIE STREFY DOSTAWY -->
            <section class="step-card" id="stepAddressSection">
              <div class="step-header">
                <div class="step-header-left">
                  <span class="step-number">03</span>
                  <h2 class="step-title">ADRES DOSTAWY I WERYFIKACJA STREFY</h2>
                </div>
                <a class="gmaps-link" id="gmapsRouteLink" href="https://www.google.com/maps/dir/Ko%C5%9Bciuszki+19,+83-300+Kartuzy/83-300+Kartuzy" target="_blank" rel="noopener">
                  Trasa Google Maps ↗
                </a>
              </div>

              <div class="form-grid-street">
                <div class="field-group">
                  <label for="inputStreet">ULICA</label>
                  <input type="text" id="inputStreet" value="ul. Jeziorna" placeholder="Nazwa ulicy" />
                </div>
                <div class="field-group">
                  <label for="inputHouseNumber">NUMER</label>
                  <input type="text" id="inputHouseNumber" value="12 / 4" placeholder="12 / 4" />
                </div>
              </div>

              <div class="form-grid-postal">
                <div class="field-group">
                  <label for="inputPostalCode">KOD POCZTOWY</label>
                  <input type="text" id="inputPostalCode" value="83-300" placeholder="83-300" />
                </div>
                <div class="field-group">
                  <label for="inputCity">MIEJSCOWOŚĆ</label>
                  <input type="text" id="inputCity" value="Kartuzy" placeholder="Kartuzy" />
                </div>
              </div>

              <!-- INTERAKTYWNA MAPA STREF DOSTAWY (KLIKNIJ NA MAPIE LUB WYBIERZ STREFĘ) -->
              <div class="map-zone-container">
                <div id="deliveryLeafletMap"></div>
                <div class="map-toolbar">
                  <div class="map-preset-btns">
                    <span style="font-weight: 700; color: #2c2b26;">Testuj strefę:</span>
                    <button type="button" class="map-chip-btn" data-zone-preset="83-300">📍 Kartuzy (Strefa A · 8 zł)</button>
                    <button type="button" class="map-chip-btn" data-zone-preset="83-304">📍 Przodkowo (Strefa B · 14 zł)</button>
                    <button type="button" class="map-chip-btn" data-zone-preset="83-330">📍 Żukowo (Strefa C · 16 zł)</button>
                    <button type="button" class="map-chip-btn" data-zone-preset="80-001">✕ Gdańsk (Poza strefą)</button>
                  </div>
                  <span id="mapDistanceBadge" style="font-weight: 700;">Dystans: 1.4 km</span>
                </div>
              </div>

              <div class="field-group">
                <label for="inputDeliveryNotes">UWAGI DLA DOSTAWCY</label>
                <textarea id="inputDeliveryNotes" placeholder="Kod do bramy, piętro..."></textarea>
              </div>

              <div class="zone-status" id="zoneValidationBox">
                <div>
                  <span id="zoneStatusIcon">✓</span>
                  <span id="zoneStatusText">Adres znajduje się w naszej strefie dostawy (Strefa A - Kartuzy, 8 zł).</span>
                </div>
                <span id="zoneMinOrderBadge" style="font-size: 11px;">Min. zamówienie: 30 zł</span>
              </div>
            </section>

            <!-- KROK 03 LUB 04: METODA PŁATNOŚCI -->
            <section class="step-card">
              <div class="step-header">
                <div class="step-header-left">
                  <span class="step-number" id="paymentStepNumberBadge">04</span>
                  <h2 class="step-title">METODA PŁATNOŚCI</h2>
                </div>
              </div>

              <div class="payment-grid">
                <button type="button" class="payment-card active" data-payment="BLIK">
                  <div class="radio-dot"></div>
                  <div>
                    <div class="option-title">BLIK</div>
                    <div class="option-sub">Kod w aplikacji</div>
                  </div>
                </button>

                <button type="button" class="payment-card" data-payment="CARD_ONLINE">
                  <div class="radio-dot"></div>
                  <div>
                    <div class="option-title">Karta online</div>
                    <div class="option-sub">Visa / Mastercard</div>
                  </div>
                </button>

                <button type="button" class="payment-card" data-payment="ON_DELIVERY">
                  <div class="radio-dot"></div>
                  <div>
                    <div class="option-title">Przy odbiorze</div>
                    <div class="option-sub">Karta lub gotówka</div>
                  </div>
                </button>
              </div>
            </section>
          </div>

          <!-- PRAWA KOLUMNA: TWOJE ZAMÓWIENIE -->
          <aside class="order-summary-card">
            <div class="summary-header">
              <h2 class="summary-title">TWOJE ZAMÓWIENIE</h2>
              <span class="summary-count" id="summaryItemsCount">1 POZYCJI</span>
            </div>

            <div id="summaryCartItemsList"></div>

            <div class="promo-box">
              <label for="inputPromoCode">KOD RABATOWY</label>
              <div class="promo-input-row">
                <input type="text" id="inputPromoCode" placeholder="Wpisz kod (np. BEMOL10)" />
                <button type="button" id="applyPromoBtn">DODAJ</button>
              </div>
            </div>

            <!-- SZYBKA KONFIGURACJA DISCORD WEBHOOK BEZPOŚREDNIO W KOSZYKU -->
            <div class="checkout-discord-box">
              <div class="checkout-discord-header">
                <span>🔔 DISCORD WEBHOOK (POWIADOMIENIA NA ŻYWO)</span>
                <span id="checkoutDiscordIndicator" style="color: #ffd166;">BRAK LINKU</span>
              </div>
              <div class="checkout-discord-row">
                <input type="url" id="checkoutDiscordWebhookInput" aria-label="Adres URL Webhooka Discord" placeholder="Wklej https://discord.com/api/webhooks/..." />
                <button type="button" id="checkoutTestDiscordBtn" title="Wyślij testowe powiadomienie na Discord">TESTUJ</button>
              </div>
              <div class="discord-live-hint" id="checkoutDiscordHint">
                Wklej adres Webhooka ze swojego kanału Discord, aby zamówienie pojawiło się na serwerze.
              </div>
            </div>

            <div class="summary-totals">
              <div class="summary-row">
                <span>Produkty</span>
                <span id="summarySubtotalVal">39 zł</span>
              </div>
              <div class="summary-row">
                <span id="summaryDeliveryLabel">Dostawa</span>
                <span id="summaryDeliveryVal">8 zł</span>
              </div>
              <div class="summary-row hidden" id="summaryDiscountRow" style="color: #d2ef62;">
                <span>Rabat</span>
                <span id="summaryDiscountVal">-0 zł</span>
              </div>
            </div>

            <div class="summary-final">
              <span>Razem</span>
              <span class="summary-final-price" id="summaryTotalVal">47 zł</span>
            </div>

            <label class="terms-label">
              <input type="checkbox" id="inputAcceptTerms" checked />
              <span>Akceptuję regulamin i politykę prywatności oraz potwierdzam poprawność danych.</span>
            </label>

            <button type="submit" class="submit-order-btn">ZAMAWIAM I PŁACĘ →</button>
            <div class="secure-note">Bezpieczne płatności + Powiadomienie Discord Webhook</div>
          </aside>
        </form>
      </main>
    </div>

