    { slug: 'burrata_ball', name: 'Dodatkowa kula sera Burrata', price32: 12, price42: 12 }
  ],
  products: [
    { id: 1, category: 'PIZZA', name: 'Diavola', price: 39, badge: 'OSTRA', description: 'sos pomidorowy, mozzarella fior di latte, spianata piccante, jalapeño', isAvailable: true, image: 'https://images.unsplash.com/photo-1628840042765-356cda07504e?auto=format&fit=crop&w=600&q=80' },
    { id: 2, category: 'PIZZA', name: 'Burrata', price: 45, badge: 'BESTSELLER', description: 'sos pomidorowy, mozzarella, burrata, pomidorki cherry, pesto, rukola', isAvailable: true, image: 'https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=600&q=80' },
    { id: 3, category: 'PIZZA', name: 'Prosciutto', price: 43, badge: 'KLASYKA', description: 'sos pomidorowy, mozzarella, prosciutto crudo, grana padano, rukola', isAvailable: true, image: 'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=600&q=80' },
    { id: 4, category: 'PIZZA', name: 'Margherita', price: 31, badge: 'VEGE', description: 'sos pomidorowy San Marzano, mozzarella fior di latte, bazylia', isAvailable: true, image: 'https://images.unsplash.com/photo-1604382354936-07c5d9983bd3?auto=format&fit=crop&w=600&q=80' },
    { id: 5, category: 'PIZZA', name: 'Capricciosa', price: 40, badge: 'KLASYKA', description: 'sos pomidorowy, mozzarella, szynka cotto, pieczarki, oliwki', isAvailable: true, image: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=600&q=80' },
    { id: 6, category: 'PIZZA', name: 'Verde', price: 42, badge: 'VEGE', description: 'krem z cukinii, mozzarella, kozi ser, szpinak, pistacje', isAvailable: true, image: 'https://images.unsplash.com/photo-1593560708920-61dd98c46a4e?auto=format&fit=crop&w=600&q=80' },
