  ],
  pizzaExtras: [
    { slug: 'extra_mozzarella', name: 'Podwójna mozzarella fior di latte', price32: 6, price42: 9 },
    { slug: 'prosciutto_crudo', name: 'Szynka Prosciutto Crudo', price32: 8, price42: 11 },
    { slug: 'spianata_piccante', name: 'Salami Spianata Piccante', price32: 7, price42: 10 },
    { slug: 'jalapeno', name: 'Papryczki Jalapeño', price32: 4, price42: 6 },
