              <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">OPCJONALNIE · DOWOLNA ILOŚĆ</span>
            </div>
            <div class="sauces-grid" id="cfgSaucesOptionsContainer"></div>
          </div>

          <!-- KROK 04: DODATKOWE SKŁADNIKI -->
