{
  "name": "bemol-backend-v10",
  "version": "10.0.0",
  "main": "server-v10.js",
  "scripts": { "start": "node server-v10.js" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  }
}

// ============================================================================
// PLIK: backend/server-v10.js
// Kompletne REST API dla modeli: Product, Category, User, Order + JWT + Walidacja
// ============================================================================

const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const cors = require('cors');
const path = require('path');
const fs = require('fs');

const app = express();
const PORT = process.env.PORT || 4000;
const JWT_SECRET = process.env.JWT_SECRET || 'bemol_jwt_secret_2026';

app.use(cors());
app.use(express.json());

const dbPath = path.join(__dirname, '../database/bemol_v10.db');
const sqlSchemaPath = path.join(__dirname, '../database/database-v10.sql');
const db = new sqlite3.Database(dbPath);

db.serialize(() => {
  if (fs.existsSync(sqlSchemaPath)) {
    db.exec(fs.readFileSync(sqlSchemaPath, 'utf-8'), (err) => {
      if (err) console.error('Błąd bazy:', err);
      else console.log('Baza danych SQLite gotowa.');
    });
  }
});

// Middleware JWT
function authenticateJWT(req, res, next) {
  const token = req.headers['authorization']?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Brak tokenu JWT.' });
  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) return res.status(403).json({ error: 'Nieprawidłowy lub wygasły token JWT.' });
    req.user = user;
    next();
  });
}

function requireAdmin(req, res, next) {
  authenticateJWT(req, res, () => {
    if (req.user.role !== 'ADMIN') return res.status(403).json({ error: 'Wymagane uprawnienia administratora.' });
    next();
  });
}

// ----------------------------------------------------------------------------
// 1. REST API: CATEGORIES (Model Category)
// ----------------------------------------------------------------------------
app.get('/api/categories', (req, res) => {
  db.all(`SELECT * FROM categories WHERE is_active = 1 ORDER BY sort_order ASC`, [], (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows);
  });
});

// ----------------------------------------------------------------------------
// 2. REST API: PRODUCTS (Model Product)
// ----------------------------------------------------------------------------
app.get('/api/products', (req, res) => {
  const { category } = req.query;
  let sql = `SELECT * FROM products`;
  const params = [];
  if (category) {
    sql += ` WHERE category_slug = ?`;
    params.push(category);
  }
  db.all(sql, params, (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows);
  });
});

app.post('/api/products', requireAdmin, (req, res) => {
  const { categorySlug, name, description, price, badge, imageUrl } = req.body;
  if (!name || !price) return res.status(400).json({ error: 'Nazwa i cena są wymagane.' });
  db.run(
    `INSERT INTO products (category_slug, name, description, price, price_32cm, price_42cm, badge, image_url) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
    [categorySlug || 'PIZZA', name, description || '', Number(price), Number(price), Number(price) + 14, badge || '', imageUrl || ''],
    function (err) {
      if (err) return res.status(500).json({ error: err.message });
      res.status(201).json({ id: this.lastID, message: 'Produkt (Product) utworzony.' });
    }
  );
});

// ----------------------------------------------------------------------------
// 3. REST API: AUTH & USERS (Model User + JWT)
// ----------------------------------------------------------------------------
app.post('/api/auth/register', async (req, res) => {
  const { fullName, email, phone, password } = req.body;
  if (!fullName || !email || !phone || !password) {
    return res.status(400).json({ error: 'Wszystkie pola są wymagane.' });
  }
  const hash = await bcrypt.hash(password, 10);
  const role = email.toLowerCase() === 'admin@bemol.pl' ? 'ADMIN' : 'CUSTOMER';

  db.run(
    `INSERT INTO users (full_name, email, phone, password_hash, role) VALUES (?, ?, ?, ?, ?)`,
    [fullName, email.toLowerCase(), phone, hash, role],
    function (err) {
      if (err) return res.status(409).json({ error: 'Użytkownik o takim e-mailu już istnieje.' });
      const user = { id: this.lastID, fullName, email: email.toLowerCase(), role };
      const token = jwt.sign(user, JWT_SECRET, { expiresIn: '7d' });
      res.status(201).json({ token, user });
    }
  );
});

app.post('/api/auth/login', (req, res) => {
  const { email, password } = req.body;
  db.get(`SELECT * FROM users WHERE email = ?`, [email?.toLowerCase()], async (err, user) => {
    if (err || !user || !(await bcrypt.compare(password, user.password_hash))) {
      return res.status(401).json({ error: 'Nieprawidłowy e-mail lub hasło.' });
    }
    const userPayload = { id: user.id, fullName: user.full_name, email: user.email, role: user.role };
    const token = jwt.sign(userPayload, JWT_SECRET, { expiresIn: '7d' });
    res.json({ token, user: userPayload });
  });
});

// ----------------------------------------------------------------------------
// 4. REST API: ORDERS & ORDER ITEMS (Model Order)
// ----------------------------------------------------------------------------
app.post('/api/orders', (req, res) => {
  const { userId, deliveryMethod, contact, address, paymentMethod, items } = req.body;
  if (!items || !items.length || !contact) {
    return res.status(400).json({ error: 'Brak pozycji w koszyku lub danych kontaktowych.' });
  }

  const subtotal = items.reduce((s, i) => s + Number(i.price) * Number(i.quantity), 0);
  const deliveryFee = deliveryMethod === 'DELIVERY' ? 8 : 0;
  const totalAmount = subtotal + deliveryFee;
  const orderNumber = 'BM-' + Date.now().toString().slice(-6);

  db.run(
    `INSERT INTO orders (order_number, user_id, delivery_method, customer_name, customer_phone, customer_email, street, house_number, postal_code, city, payment_method, order_status, subtotal, delivery_fee, total_amount)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'NEW', ?, ?, ?)`,
    [orderNumber, userId || null, deliveryMethod, contact.fullName, contact.phone, contact.email, address?.street || '', address?.houseNumber || '', address?.postalCode || '83-300', address?.city || 'Kartuzy', paymentMethod || 'BLIK', subtotal, deliveryFee, totalAmount],
    function (err) {
      if (err) return res.status(500).json({ error: err.message });
      const orderId = this.lastID;

      const stmt = db.prepare(`INSERT INTO order_items (order_id, product_id, product_name, unit_price, quantity, line_total) VALUES (?, ?, ?, ?, ?, ?)`);
      items.forEach(it => stmt.run([orderId, it.id || 1, it.name, it.price, it.quantity, it.price * it.quantity]));
      stmt.finalize();

      res.status(201).json({ message: 'Zamówienie (Order) utworzone.', orderId, orderNumber, totalAmount, orderStatus: 'NEW' });
    }
  );
});

// Pobieranie zamówień przez Administratora
app.get('/api/admin/orders', requireAdmin, (req, res) => {
  db.all(
    `SELECT o.*, GROUP_CONCAT(oi.quantity || 'x ' || oi.product_name, ', ') AS items_summary FROM orders o LEFT JOIN order_items oi ON o.id = oi.order_id GROUP BY o.id ORDER BY o.created_at DESC`,
    [],
    (err, rows) => {
      if (err) return res.status(500).json({ error: err.message });
      res.json(rows);
    }
  );
});

// Obsługa statusu zamówienia (Order Status)
app.patch('/api/admin/orders/:id/status', requireAdmin, (req, res) => {
  const { orderStatus } = req.body;
  const valid = ['NEW', 'PREPARING', 'IN_OVEN', 'IN_DELIVERY', 'READY_FOR_PICKUP', 'COMPLETED', 'CANCELLED'];
  if (!valid.includes(orderStatus)) return res.status(400).json({ error: 'Nieprawidłowy status zamówienia.' });

  db.run(`UPDATE orders SET order_status = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?`, [orderStatus, req.params.id], function (err) {
    if (err) return res.status(500).json({ error: err.message });
    res.json({ message: 'Status zamówienia zmieniony pomyślnie.', orderStatus });
  });
});

app.listen(PORT, () => {
  console.log(`Serwer REST API v10 działa na http://localhost:${PORT}`);
});

-- ============================================================================
-- PLIK: database/database-v10.sql
-- Pełne modele danych: Product, Category, User, Order, OrderItem + Strefy i Konfigurator
-- Pizzeria BEMOL (ul. Kościuszki 19, 83-300 Kartuzy)
-- ============================================================================

PRAGMA foreign_keys = ON;

-- 1. MODEL USER
CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(120) NOT NULL UNIQUE,
    phone VARCHAR(25) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(20) DEFAULT 'CUSTOMER' CHECK (role IN ('CUSTOMER', 'ADMIN')),
    street VARCHAR(120),
    house_number VARCHAR(30),
    postal_code VARCHAR(10) DEFAULT '83-300',
    city VARCHAR(80) DEFAULT 'Kartuzy',
    loyalty_points INTEGER DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. MODEL CATEGORY
CREATE TABLE IF NOT EXISTS categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    slug VARCHAR(40) NOT NULL UNIQUE,
    name VARCHAR(50) NOT NULL,
    sort_order INTEGER DEFAULT 1,
    has_pizza_configurator BOOLEAN DEFAULT 0,
    is_active BOOLEAN DEFAULT 1
);

-- 3. MODEL PRODUCT
CREATE TABLE IF NOT EXISTS products (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    category_slug VARCHAR(40) NOT NULL,
    name VARCHAR(100) NOT NULL,
    description TEXT NOT NULL,
    price DECIMAL(10, 2) NOT NULL DEFAULT 39.00,
    price_32cm DECIMAL(10, 2) NOT NULL CHECK (price_32cm >= 0),
    price_42cm DECIMAL(10, 2) NOT NULL CHECK (price_42cm >= 0),
    badge VARCHAR(30),
    image_url TEXT NOT NULL,
    is_available BOOLEAN DEFAULT 1,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (category_slug) REFERENCES categories(slug) ON DELETE CASCADE
);

-- 4. MODEL ORDER
CREATE TABLE IF NOT EXISTS orders (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_number VARCHAR(25) NOT NULL UNIQUE,
    user_id INTEGER,
    delivery_method VARCHAR(20) NOT NULL CHECK (delivery_method IN ('DELIVERY', 'PICKUP')),
    customer_name VARCHAR(100) NOT NULL,
    customer_phone VARCHAR(25) NOT NULL,
    customer_email VARCHAR(120) NOT NULL,
    street VARCHAR(120),
    house_number VARCHAR(30),
    postal_code VARCHAR(10),
    city VARCHAR(80),
    delivery_notes TEXT,
    payment_method VARCHAR(20) NOT NULL CHECK (payment_method IN ('BLIK', 'CARD_ONLINE', 'ON_DELIVERY')),
    payment_status VARCHAR(40) DEFAULT 'PENDING',
    order_status VARCHAR(25) DEFAULT 'NEW' CHECK (order_status IN ('NEW', 'PREPARING', 'IN_OVEN', 'IN_DELIVERY', 'READY_FOR_PICKUP', 'COMPLETED', 'CANCELLED')),
    subtotal DECIMAL(10, 2) NOT NULL,
    delivery_fee DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
    discount_amount DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
    total_amount DECIMAL(10, 2) NOT NULL,
    promo_code VARCHAR(30),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL
);

-- 5. MODEL ORDER_ITEM
CREATE TABLE IF NOT EXISTS order_items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id INTEGER NOT NULL,
    product_id INTEGER NOT NULL,
    product_name VARCHAR(150) NOT NULL,
    size_cm INTEGER DEFAULT 32,
    dough_name VARCHAR(80) DEFAULT 'Klasyczne Włoskie',
    selected_sauces TEXT,
    selected_extras TEXT,
    unit_price DECIMAL(10, 2) NOT NULL,
    quantity INTEGER NOT NULL CHECK (quantity > 0),
    line_total DECIMAL(10, 2) NOT NULL,
    FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id)
);

