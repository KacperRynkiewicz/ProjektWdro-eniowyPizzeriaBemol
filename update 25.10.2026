function saveState() {
  localStorage.setItem('bemol_v5_products', JSON.stringify(AppState.products));
  localStorage.setItem('bemol_v5_cart', JSON.stringify(AppState.cart));
  localStorage.setItem('bemol_v5_orders', JSON.stringify(AppState.orders));
  if (AppState.user && AppState.jwtToken) {
    localStorage.setItem('bemol_v5_user', JSON.stringify(AppState.user));
    localStorage.setItem('bemol_v5_jwt', AppState.jwtToken);
  } else {
    localStorage.removeItem('bemol_v5_user');
    localStorage.removeItem('bemol_v5_jwt');
  }
}

// ============================================================================
// KONFIGURATOR WARIANTÓW CIASTA, ROZMIARÓW (32 CM / 42 CM) I SOSÓW
// ============================================================================
function openPizzaConfigurator(product) {
  AppState.configModal = {
    product,
    sizeCm: 32,
    doughSlug: 'klasyczne',
    selectedSauces: [],
    selectedExtras: [],
    quantity: 1
  };

  document.getElementById('cfgPizzaImage').src = product.image;
  document.getElementById('cfgPizzaName').textContent = product.name;
  document.getElementById('cfgPizzaDesc').textContent = product.description;
  document.getElementById('cfgPizzaBadge').textContent = product.badge
    ? `${product.badge} · KONFIGURATOR PIZZY`
    : 'KONFIGURATOR PIZZY BEMOL';

  renderConfiguratorOptions();
  document.getElementById('pizzaConfiguratorModal').classList.remove('hidden');
}

function calculateConfiguredUnitPrice() {
  const cfg = AppState.configModal;
  if (!cfg.product) return 0;

  const sizeObj = INITIAL_DATA.pizzaSizes.find((s) => s.cm === cfg.sizeCm) || INITIAL_DATA.pizzaSizes[0];
  const baseWithSize = cfg.product.price + sizeObj.surcharge;

  const doughObj = INITIAL_DATA.doughVariants.find((d) => d.slug === cfg.doughSlug) || INITIAL_DATA.doughVariants[0];
  const doughSurcharge = cfg.sizeCm === 42 ? doughObj.surcharge42 : doughObj.surcharge32;

  const saucesSum = cfg.selectedSauces.reduce((sum, slug) => {
    const sObj = INITIAL_DATA.pizzaSauces.find((s) => s.slug === slug);
    return sum + (sObj ? sObj.price : 0);
  }, 0);

  const extrasSum = cfg.selectedExtras.reduce((sum, slug) => {
    const eObj = INITIAL_DATA.pizzaExtras.find((e) => e.slug === slug);
    if (!eObj) return sum;
    return sum + (cfg.sizeCm === 42 ? eObj.price42 : eObj.price32);
  }, 0);

  return baseWithSize + doughSurcharge + saucesSum + extrasSum;
}

function renderConfiguratorOptions() {
  const cfg = AppState.configModal;
  if (!cfg.product) return;

  // 1. Renderowanie rozmiarów (32 cm vs 42 cm)
  const sizeContainer = document.getElementById('cfgSizeOptionsContainer');
  sizeContainer.innerHTML = '';
  INITIAL_DATA.pizzaSizes.forEach((sz) => {
    const isActive = cfg.sizeCm === sz.cm;
    const priceForSize = cfg.product.price + sz.surcharge;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'size-option-card' + (isActive ? ' active' : '');
    const circlePx = sz.cm === 32 ? 42 : 52;
    btn.innerHTML = `
      <div class="size-pizza-circle" style="width:${circlePx}px; height:${circlePx}px; font-size:${sz.cm === 32 ? 13 : 15}px;">
        ${sz.cm}
      </div>
      <div style="flex:1;">
        <div style="display:flex; justify-content:space-between; align-items:baseline;">
          <strong style="font-size:14px;">${sz.label}</strong>
          <strong style="font-family:var(--font-display); font-size:20px; color:var(--accent-red);">${priceForSize} zł</strong>
        </div>
        <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">${sz.sub}</div>
      </div>
    `;
    btn.addEventListener('click', () => {
      cfg.sizeCm = sz.cm;
      renderConfiguratorOptions();
    });
    sizeContainer.appendChild(btn);
  });

  // 2. Renderowanie wariantów ciasta
  const doughContainer = document.getElementById('cfgDoughOptionsContainer');
  doughContainer.innerHTML = '';
  INITIAL_DATA.doughVariants.forEach((d) => {
    const isActive = cfg.doughSlug === d.slug;
    const cost = cfg.sizeCm === 42 ? d.surcharge42 : d.surcharge32;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dough-option-card' + (isActive ? ' active' : '');
    btn.innerHTML = `
      <div class="dough-top-row">
        <span>${d.name}</span>
        <span class="dough-surcharge">${cost > 0 ? `+${cost} zł` : 'W cenie'}</span>
      </div>
      <div class="dough-desc">${d.desc}</div>
    `;
    btn.addEventListener('click', () => {
      cfg.doughSlug = d.slug;
      renderConfiguratorOptions();
    });
    doughContainer.appendChild(btn);
  });

  // 3. Renderowanie sosów do pizzy (wielokrotny wybór)
  const saucesContainer = document.getElementById('cfgSaucesOptionsContainer');
  saucesContainer.innerHTML = '';
  INITIAL_DATA.pizzaSauces.forEach((sc) => {
    const isSelected = cfg.selectedSauces.includes(sc.slug);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'sauce-check-card' + (isSelected ? ' active' : '');
    btn.innerHTML = `
      <div class="sauce-check-left">
        <span class="sauce-box-indicator">${isSelected ? '✓' : ''}</span>
        <span style="text-align:left; font-weight:600;">${sc.name}</span>
      </div>
      <strong style="color:var(--accent-red); font-size:12px; white-space:nowrap;">+${sc.price} zł</strong>
    `;
    btn.addEventListener('click', () => {
      if (isSelected) {
        cfg.selectedSauces = cfg.selectedSauces.filter((s) => s !== sc.slug);
      } else {
        cfg.selectedSauces.push(sc.slug);
      }
      renderConfiguratorOptions();
    });
    saucesContainer.appendChild(btn);
  });

  // 4. Renderowanie dodatkowych składników na pizzę
  const extrasContainer = document.getElementById('cfgExtrasOptionsContainer');
  extrasContainer.innerHTML = '';
  INITIAL_DATA.pizzaExtras.forEach((ex) => {
    const isSelected = cfg.selectedExtras.includes(ex.slug);
    const exPrice = cfg.sizeCm === 42 ? ex.price42 : ex.price32;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'sauce-check-card' + (isSelected ? ' active' : '');
    btn.innerHTML = `
      <div class="sauce-check-left">
        <span class="sauce-box-indicator">${isSelected ? '✓' : ''}</span>
        <span style="text-align:left; font-weight:600;">${ex.name}</span>
      </div>
      <strong style="color:var(--accent-red); font-size:12px; white-space:nowrap;">+${exPrice} zł</strong>
    `;
    btn.addEventListener('click', () => {
      if (isSelected) {
        cfg.selectedExtras = cfg.selectedExtras.filter((e) => e !== ex.slug);
      } else {
        cfg.selectedExtras.push(ex.slug);
      }
      renderConfiguratorOptions();
    });
    extrasContainer.appendChild(btn);
  });

  // 5. Aktualizacja ilości i łącznej ceny w stopce modala
  const unitPrice = calculateConfiguredUnitPrice();
  const totalLinePrice = unitPrice * cfg.quantity;
  document.getElementById('cfgQtyValue').textContent = cfg.quantity;
  document.getElementById('cfgLiveTotalPrice').textContent = `${totalLinePrice} zł →`;
}

function confirmAddConfiguredPizzaToCart() {
  const cfg = AppState.configModal;
  if (!cfg.product) return;

  const unitPrice = calculateConfiguredUnitPrice();
  const doughObj = INITIAL_DATA.doughVariants.find((d) => d.slug === cfg.doughSlug) || INITIAL_DATA.doughVariants[0];
  const sauceNames = cfg.selectedSauces.map((slug) => INITIAL_DATA.pizzaSauces.find((s) => s.slug === slug)?.name.replace(' (80ml)', '').replace(' (30ml)', '')).filter(Boolean);
  const extraNames = cfg.selectedExtras.map((slug) => INITIAL_DATA.pizzaExtras.find((e) => e.slug === slug)?.name).filter(Boolean);

  const cartItemId = `${cfg.product.id}_${cfg.sizeCm}_${cfg.doughSlug}_${ [...cfg.selectedSauces].sort().join('-') }_${ [...cfg.selectedExtras].sort().join('-') }`;

  const existing = AppState.cart.find((item) => item.cartItemId === cartItemId);
  if (existing) {
    existing.quantity += cfg.quantity;
  } else {
    AppState.cart.push({
      cartItemId,
      id: cfg.product.id,
      name: cfg.product.name,
      sizeCm: cfg.sizeCm,
      doughName: doughObj.name,
      sauces: sauceNames,
      extras: extraNames,
      price: unitPrice,
      quantity: cfg.quantity,
      image: cfg.product.image
    });
  }

  saveState();
  updateHeaderAndFloatingCart();
  document.getElementById('pizzaConfiguratorModal').classList.add('hidden');
}

// ============================================================================
// ODLEGŁOŚĆ HAVERSINE, DISCORD WEBHOOK I MAPA STREF
// ============================================================================
function calcDistanceKm(lat1, lon1, lat2, lon2) {
  const R = 6371;
  const dLat = ((lat2 - lat1) * Math.PI) / 180;
  const dLon = ((lon2 - lon1) * Math.PI) / 180;
  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos((lat1 * Math.PI) / 180) *
      Math.cos((lat2 * Math.PI) / 180) *
      Math.sin(dLon / 2) *
      Math.sin(dLon / 2);
  return Number((R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))).toFixed(2));
}

function createSimulatedJWT(payload) {
  const header = btoa(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));
  const body = btoa(unescape(encodeURIComponent(JSON.stringify({ ...payload, iat: Date.now(), exp: Date.now() + 604800000 }))));
  const signature = btoa('bemol_kartuzy_signature_2026');
  return `${header}.${body}.${signature}`;
}

function formatCartItemFullLabel(item) {
  if (!item.sizeCm) return item.name;
  const parts = [`${item.sizeCm} cm`, item.doughName || 'Klasyczne Włoskie'];
  if (item.sauces && item.sauces.length) parts.push(`Sosy: ${item.sauces.join(', ')}`);
  if (item.extras && item.extras.length) parts.push(`Dodatki: ${item.extras.join(', ')}`);
  return `${item.name} (${parts.join(' · ')})`;
}

// Walidacja wszystkich oficjalnych domen Discord Webhook (discord.com, discordapp.com, ptb, canary, v10)
function normalizeDiscordWebhookUrl(rawUrl) {
  if (!rawUrl || typeof rawUrl !== 'string') return '';
  return rawUrl.trim().replace(/\s+/g, '');
}

function isValidDiscordWebhookUrl(rawUrl) {
  const clean = normalizeDiscordWebhookUrl(rawUrl);
  return /^https:\/\/(?:ptb\.|canary\.)?discord(?:app)?\.com\/api(?:\/v\d+)?\/webhooks\/\d+\/[\w-]+/i.test(clean);
}

// Synchronizacja pola Discord Webhook pomiędzy Koszykiem, Panelem Admina i localStorage
function syncDiscordWebhookUrl(newUrl) {
  const clean = normalizeDiscordWebhookUrl(newUrl);
  AppState.discordWebhookUrl = clean;
  localStorage.setItem('bemol_v5_discord_url', clean);

  const adminInput = document.getElementById('inputDiscordWebhookUrl');
  if (adminInput && adminInput.value !== clean) adminInput.value = clean;

  const checkoutInput = document.getElementById('checkoutDiscordWebhookInput');
  if (checkoutInput && checkoutInput.value !== clean) checkoutInput.value = clean;

  const isValid = isValidDiscordWebhookUrl(clean);

  const adminBadge = document.getElementById('discordStatusBadge');
  if (adminBadge) {
    adminBadge.textContent = isValid
      ? 'POŁĄCZONO Z DISCORD (GOTOWY DO WYSYŁKI)'
      : (clean ? 'NIEPRAWIDŁOWY FORMAT URL DISCORD' : 'BRAK ADRESU WEBHOOK URL');
    adminBadge.className = 'status-pill ' + (isValid ? 'done' : 'new');
  }

  const checkoutInd = document.getElementById('checkoutDiscordIndicator');
  const checkoutHint = document.getElementById('checkoutDiscordHint');
  if (checkoutInd) {
    checkoutInd.textContent = isValid ? '✓ AKTYWNY' : (clean ? '✕ BŁĘDNY LINK' : 'BRAK LINKU');
    checkoutInd.style.color = isValid ? '#d2ef62' : '#ffd166';
  }
  if (checkoutHint) {
    checkoutHint.textContent = isValid
      ? 'Webhook aktywny! Po kliknięciu „ZAMAWIAM I PŁACĘ” powiadomienie trafi od razu na Twój serwer Discord.'
      : 'Wklej link Webhooka z ustawień kanału Discord (Integracje -> Webhooki -> Kopiuj adres URL webhooka).';
  }
}

// 3-ETAPOWY SILNIK WYSYŁKI POWIADOMIEŃ DISCORD (Gwarantuje dostarczalność w każdym trybie)
async function triggerDiscordWebhook(order, eventLabel) {
  // Pobierz najświeższy adres URL z dowolnego pola lub pamięci stanu
  const adminInputVal = document.getElementById('inputDiscordWebhookUrl')?.value;
  const checkoutInputVal = document.getElementById('checkoutDiscordWebhookInput')?.value;
  const candidateUrl = normalizeDiscordWebhookUrl(
    AppState.discordWebhookUrl || checkoutInputVal || adminInputVal || localStorage.getItem('bemol_v5_discord_url') || ''
  );

  if (candidateUrl) {
    syncDiscordWebhookUrl(candidateUrl);
  }

  const safeItemsText = Array.isArray(order.items) && order.items.length > 0
    ? order.items.map((i) => `• ${i.quantity}x **${i.name}** (${i.price * i.quantity} zł)`).join('\n').slice(0, 1020)
    : 'Brak pozycji';

  const payload = {
    username: 'Pizzeria BEMOL Kartuzy',
    content: `🍕 **${eventLabel}** — Zamówienie **#${order.orderNumber}** na kwotę **${order.total} zł** (${order.deliveryMethod === 'DELIVERY' ? 'Dostawa' : 'Odbiór osobisty'})`,
    embeds: [
      {
        title: `${eventLabel}: Zamówienie #${order.orderNumber} (${order.total} zł)`,
        color: 12069908,
        fields: [
          {
            name: 'Sposób odbioru',
            value: order.deliveryMethod === 'DELIVERY'
              ? `📍 Dostawa: ${order.address || 'Kartuzy'}`
              : '🛍️ Odbiór osobisty (ul. Kościuszki 19, 83-300 Kartuzy)',
            inline: false
          },
          {
            name: 'Klient',
            value: `${order.customerName || 'Gość'} (${order.customerPhone || '-'})`,
            inline: true
          },
          {
            name: 'Płatność & Status',
            value: `${order.paymentMethod || 'BLIK'} (${order.paymentStatus || 'OPŁACONE'}) | Status: **${order.orderStatus || 'NEW'}**`,
            inline: true
          },
          {
            name: 'Pozycje zamówienia (z konfiguracją ciasta i sosów)',
            value: safeItemsText,
            inline: false
          }
        ],
        footer: { text: 'BEMOL Webhook System • ' + new Date().toLocaleString('pl-PL') }
      }
    ]
  };

  let statusText = '';
  let delivered = false;

  if (!candidateUrl) {
    statusText = '⚠️ Nie wysłano na Discord: Brak wklejonego adresu URL Webhooka (wklej go w Koszyku lub Panelu Admina).';
  } else if (!isValidDiscordWebhookUrl(candidateUrl)) {
    statusText = '❌ Błąd: Podany adres URL nie jest prawidłowym linkiem Discord Webhook (wymagany https://discord.com/api/webhooks/ID/TOKEN).';
  } else {
    // ETAP 1: Bezpośrednie żądanie POST JSON z parametrem ?wait=true
    try {
      const waitUrl = candidateUrl.includes('?') ? `${candidateUrl}&wait=true` : `${candidateUrl}?wait=true`;
      const directRes = await fetch(waitUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (directRes.ok) {
        delivered = true;
        statusText = `✅ Wysłano na żywo na serwer Discord (HTTP ${directRes.status} OK)!`;
      } else {
        const errBody = await directRes.text();
        statusText = `❌ Serwer Discord odrzucił żądanie (HTTP ${directRes.status}): ${errBody.slice(0, 120)}`;
      }
    } catch (directErr) {
      // ETAP 2: Przekaźnik serwerowy Node.js (/api/discord-proxy) - omija blokady CORS i AdBlock
      try {
        const proxyEndpoints = ['/api/discord-proxy', 'http://localhost:3000/api/discord-proxy', 'http://localhost:4000/api/discord-proxy'];
        for (const ep of proxyEndpoints) {
          try {
            const proxyRes = await fetch(ep, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                webhookUrl: candidateUrl,
                payload,
                orderId: order.id,
                eventType: eventLabel
              })
            });
            if (proxyRes.ok) {
              delivered = true;
              statusText = `✅ Wysłano na serwer Discord przez lokalne Proxy Node.js (${ep})!`;
              break;
            }
          } catch (_) {
            // Przejdź do kolejnego endpointu
          }
        }
      } catch (_) {}

      // ETAP 3: Awaryjna wysyłka FormData (multipart/form-data z payload_json + no-cors)
      // Żądanie proste wg specyfikacji W3C Fetch - NIE wywołuje preflight OPTIONS i działa nawet z pliku file://
      if (!delivered) {
        try {
          const formData = new FormData();
          formData.append('payload_json', JSON.stringify(payload));
          await fetch(candidateUrl, {
            method: 'POST',
            mode: 'no-cors',
            body: formData
          });
          delivered = true;
          statusText = '✅ Wysłano na serwer Discord (Tryb bezpośredni FormData payload_json bez preflight CORS)!';
        } catch (fallbackErr) {
          statusText = `❌ Błąd sieci podczas wysyłki na Discord: ${fallbackErr.message}`;
        }
      }
    }
  }

  AppState.discordLogs.unshift({
    time: new Date().toLocaleTimeString('pl-PL'),
    orderNumber: order.orderNumber,
    eventLabel,
    statusText
  });

  renderDiscordLogs();
  return { delivered, statusText };
}

function renderDiscordLogs() {
  const el = document.getElementById('discordLogsContainer');
  if (!el) return;
  if (AppState.discordLogs.length === 0) {
    el.innerHTML = 'Brak wysłanych powiadomień w tej sesji.';
    return;
  }
  el.innerHTML = AppState.discordLogs
    .slice(0, 5)
    .map(
      (l) => `<div style="padding: 4px 0; border-bottom: 1px dashed #d5d2c7;">
        <strong>[${l.time}]</strong> Zamówienie <strong>#${l.orderNumber}</strong> (${l.eventLabel}) — <span style="color:#1f3608; font-weight:700;">${l.statusText}</span>
      </div>`
    )
    .join('');
}

function initDeliveryMap() {
  const mapEl = document.getElementById('deliveryLeafletMap');
  if (!mapEl || typeof L === 'undefined') return;

  if (leafletMap) {
    setTimeout(() => leafletMap.invalidateSize(), 150);
    return;
  }

  leafletMap = L.map('deliveryLeafletMap').setView([BEMOL_CENTER.lat, BEMOL_CENTER.lng], 12);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap | Pizzeria BEMOL Kartuzy'
  }).addTo(leafletMap);

  L.circle([BEMOL_CENTER.lat, BEMOL_CENTER.lng], {
    color: '#d2ef62',
    fillColor: '#d2ef62',
    fillOpacity: 0.18,
    radius: 5000
  }).addTo(leafletMap);

  L.circle([BEMOL_CENTER.lat, BEMOL_CENTER.lng], {
    color: '#e25336',
    fillColor: '#e25336',
    fillOpacity: 0.06,
    radius: 13000
  }).addTo(leafletMap);

  L.marker([BEMOL_CENTER.lat, BEMOL_CENTER.lng])
    .addTo(leafletMap)
    .bindPopup('<strong>Pizzeria BEMOL</strong><br>ul. Kościuszki 19, 83-300 Kartuzy')
    .openPopup();

  customerMarker = L.marker([AppState.customerCoords.lat, AppState.customerCoords.lng], { draggable: true })
    .addTo(leafletMap)
    .bindPopup('Twój adres dostawy');

  customerMarker.on('dragend', (e) => {
    const pos = e.target.getLatLng();
    evaluateMapCoordinates(pos.lat, pos.lng);
  });

  leafletMap.on('click', (e) => {
    customerMarker.setLatLng(e.latlng);
    evaluateMapCoordinates(e.latlng.lat, e.latlng.lng);
  });
}

function evaluateMapCoordinates(lat, lng) {
  AppState.customerCoords = { lat, lng };
  const dist = calcDistanceKm(BEMOL_CENTER.lat, BEMOL_CENTER.lng, lat, lng);
  AppState.currentDistanceKm = dist;

  document.getElementById('mapDistanceBadge').textContent = `Dystans: ${dist} km`;
  document.getElementById('gmapsRouteLink').href =
    `https://www.google.com/maps/dir/Ko%C5%9Bciuszki+19,+83-300+Kartuzy/${lat.toFixed(5)},${lng.toFixed(5)}`;

  const box = document.getElementById('zoneValidationBox');
  const icon = document.getElementById('zoneStatusIcon');
  const text = document.getElementById('zoneStatusText');
  const minBadge = document.getElementById('zoneMinOrderBadge');

  if (dist <= 5.0) {
    AppState.currentZoneValid = true;
    AppState.currentDeliveryFee = 8;
    box.classList.remove('out-of-zone');
    icon.textContent = '✓';
    text.textContent = `Adres znajduje się w naszej strefie dostawy (Strefa A · ${dist} km · dostawa 8 zł).`;
    minBadge.textContent = 'Min. zamówienie: 30 zł';
  } else if (dist <= 13.5) {
    AppState.currentZoneValid = true;
    AppState.currentDeliveryFee = dist <= 10 ? 14 : 16;
    box.classList.remove('out-of-zone');
    icon.textContent = '✓';
    text.textContent = `Adres w strefie podmiejskiej (${dist} km od lokalu · dostawa ${AppState.currentDeliveryFee} zł).`;
    minBadge.textContent = 'Min. zamówienie: 50 zł';
  } else {
    AppState.currentZoneValid = false;
    box.classList.add('out-of-zone');
    icon.textContent = '✕';
    text.textContent = `Punkt oddalony o ${dist} km — poza strefą dostawy (maks. 13.5 km). Wybierz odbiór osobisty.`;
    minBadge.textContent = 'Poza zasięgiem kuriera';
  }
  renderCheckoutSummary();
}

function verifyZoneByPostalCode() {
  const code = document.getElementById('inputPostalCode').value.trim();
  const zone = INITIAL_DATA.zones[code];
  const box = document.getElementById('zoneValidationBox');
  const icon = document.getElementById('zoneStatusIcon');
  const text = document.getElementById('zoneStatusText');
  const minBadge = document.getElementById('zoneMinOrderBadge');

  if (zone) {
    document.getElementById('inputCity').value = zone.city;
    AppState.currentZoneValid = true;
    AppState.currentDeliveryFee = zone.fee;
    const dist = calcDistanceKm(BEMOL_CENTER.lat, BEMOL_CENTER.lng, zone.lat, zone.lng);
    AppState.currentDistanceKm = dist;
    document.getElementById('mapDistanceBadge').textContent = `Dystans: ${dist} km`;

    if (leafletMap && customerMarker) {
      customerMarker.setLatLng([zone.lat, zone.lng]);
      leafletMap.panTo([zone.lat, zone.lng]);
    }

    box.classList.remove('out-of-zone');
    icon.textContent = '✓';
    text.textContent = `Adres znajduje się w naszej strefie dostawy (${zone.name} · ${zone.fee} zł).`;
    minBadge.textContent = `Min. zamówienie: ${zone.minOrder} zł`;
  } else {
    AppState.currentZoneValid = false;
    box.classList.add('out-of-zone');
    icon.textContent = '✕';
    text.textContent = 'Kod pocztowy poza strefą dostawy (obsługujemy: 83-300 Kartuzy, 83-304 Przodkowo, 83-330 Żukowo, 83-333 Chmielno).';
    minBadge.textContent = 'Wybierz odbiór osobisty';
  }
  renderCheckoutSummary();
}

function switchView(viewName) {
  AppState.currentView = viewName;
  document.getElementById('mobileNavDrawer').classList.add('hidden');
  document.getElementById('mobileMenuToggleBtn').textContent = '☰';

  document.getElementById('viewMenu').classList.toggle('hidden', viewName !== 'MENU');
  document.getElementById('viewCheckout').classList.toggle('hidden', viewName !== 'CHECKOUT');
  document.getElementById('viewAuthAndHistory').classList.toggle('hidden', viewName !== 'AUTH_HISTORY');
  document.getElementById('viewAdminPanel').classList.toggle('hidden', viewName !== 'ADMIN');

  document.getElementById('navMenuBtn').classList.toggle('active', viewName === 'MENU');
  document.getElementById('navHistoryBtn').classList.toggle('active', viewName === 'AUTH_HISTORY');
  document.getElementById('navAdminBtn').classList.toggle('active', viewName === 'ADMIN');

  if (viewName === 'CHECKOUT') {
    populateCheckoutFromUser();
    renderCheckoutSummary();
    setTimeout(initDeliveryMap, 100);
  } else if (viewName === 'AUTH_HISTORY') {
    renderAuthAndHistoryView();
  } else if (viewName === 'ADMIN') {
    renderAdminPanel();
  }

  updateHeaderAndFloatingCart();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function renderCategories() {
  const container = document.getElementById('categoryPillsContainer');
  container.innerHTML = '';

  INITIAL_DATA.categories.forEach((cat) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'category-pill' + (AppState.selectedCategory === cat.slug ? ' active' : '');
    btn.textContent = cat.name;
    btn.addEventListener('click', () => {
      AppState.selectedCategory = cat.slug;
      renderCategories();
      renderProductsGrid();
    });
    container.appendChild(btn);
  });
}

function renderProductsGrid() {
  const grid = document.getElementById('productsGridContainer');
  grid.innerHTML = '';

  const filtered = AppState.products.filter((p) => p.category === AppState.selectedCategory);

  filtered.forEach((product, idx) => {
    const card = document.createElement('article');
    card.className = 'product-card';
    const loadingAttr = idx < 2 ? 'eager' : 'lazy';
    const isPizza = product.category === 'PIZZA';
    const price42 = product.price + 14;

    card.innerHTML = `
      <div class="product-image-wrap">
        <img src="${product.image}" alt="Pizza ${product.name} - Pizzeria BEMOL Kartuzy" loading="${loadingAttr}" decoding="async" />
        ${product.badge ? `<span class="product-badge">${product.badge}</span>` : ''}
      </div>
      <div class="product-header">
        <h2 class="product-title">${product.name}</h2>
        <span class="product-price">${product.price} zł</span>
      </div>
      ${
        isPizza
          ? `<div class="product-size-hint">
               <span class="size-chip-tag">32 cm: ${product.price} zł</span>
               <span class="size-chip-tag">42 cm: ${price42} zł</span>
               <span class="size-chip-tag">+ Ciasto i sosy</span>
             </div>`
          : ''
      }
      <p class="product-desc">${product.description}</p>
      <button type="button" class="add-to-cart-btn" ${!product.isAvailable ? 'disabled' : ''} data-add-id="${product.id}">
        ${!product.isAvailable ? 'CHWILOWO NIEDOSTĘPNE' : '+ DODAJ'}
      </button>
    `;
    if (product.isAvailable) {
      card.querySelector('[data-add-id]').addEventListener('click', () => {
        if (isPizza) {
          openPizzaConfigurator(product);
        } else {
          addDirectProductToCart(product);
        }
      });
    }
    grid.appendChild(card);
  });
}

function addDirectProductToCart(product) {
  const cartItemId = `${product.id}_std`;
  const existing = AppState.cart.find((item) => item.cartItemId === cartItemId);
  if (existing) {
    existing.quantity += 1;
    existing.price = product.price;
  } else {
    AppState.cart.push({
      cartItemId,
      id: product.id,
      name: product.name,
      sizeCm: null,
      doughName: null,
      sauces: [],
      extras: [],
      price: product.price,
      quantity: 1,
      image: product.image
    });
  }
  saveState();
  updateHeaderAndFloatingCart();
}

function changeCartQuantity(cartItemId, delta) {
  AppState.cart = AppState.cart
    .map((item) => (item.cartItemId === cartItemId ? { ...item, quantity: item.quantity + delta } : item))
    .filter((item) => item.quantity > 0);
  saveState();
  updateHeaderAndFloatingCart();
  renderCheckoutSummary();
}

function updateHeaderAndFloatingCart() {
  const totalCount = AppState.cart.reduce((sum, item) => sum + item.quantity, 0);
  const subtotal = AppState.cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  const badge = document.getElementById('cartBadgeCount');
  badge.textContent = totalCount;
  badge.classList.toggle('hidden', totalCount === 0);

  const floatingBar = document.getElementById('mobileFloatingCartBar');
  const showFloating = totalCount > 0 && AppState.currentView === 'MENU';
  floatingBar.classList.toggle('visible-on-mobile', showFloating);
  floatingBar.classList.toggle('hidden', !showFloating);

  document.getElementById('mfcCountLabel').textContent = `${totalCount} POZYCJI W KOSZYKU`;
  document.getElementById('mfcTotalValue').textContent = `${subtotal} zł`;

  const jwtBadge = document.getElementById('jwtStatusIndicator');
  const userBtn = document.getElementById('userProfileBtn');
  const userLabel = document.getElementById('userHeaderLabel');

  if (AppState.user && AppState.jwtToken) {
    jwtBadge.textContent = `JWT Aktywny: ${AppState.user.fullName}`;
    userBtn.classList.add('logged-in');
    userLabel.textContent = AppState.user.fullName.split(' ')[0];
  } else {
    jwtBadge.textContent = 'JWT: Gość (Niezalogowany)';
    userBtn.classList.remove('logged-in');
    userLabel.textContent = 'Konto';
  }
}

function setDeliveryMethod(method) {
  AppState.deliveryMethod = method;
  const isDelivery = method === 'DELIVERY';

  document.getElementById('optDeliveryBtn').classList.toggle('active', isDelivery);
  document.getElementById('optPickupBtn').classList.toggle('active', !isDelivery);
  document.getElementById('pickupInfoBanner').classList.toggle('hidden', isDelivery);
  document.getElementById('stepAddressSection').classList.toggle('hidden', !isDelivery);

  document.getElementById('paymentStepNumberBadge').textContent = isDelivery ? '04' : '03';
  if (isDelivery) {
    setTimeout(() => leafletMap && leafletMap.invalidateSize(), 120);
  }
  renderCheckoutSummary();
}

function calculateCheckoutTotals() {
  const subtotal = AppState.cart.reduce((s, i) => s + i.price * i.quantity, 0);
  const isDelivery = AppState.deliveryMethod === 'DELIVERY';
  const deliveryFee = isDelivery && subtotal > 0 ? AppState.currentDeliveryFee : 0;

  let discountAmount = 0;
  if (AppState.appliedPromo) {
    const promo = INITIAL_DATA.promoCodes[AppState.appliedPromo];
    if (promo && subtotal >= promo.minOrder) {
      discountAmount = promo.type === 'PERCENT' ? Math.round((subtotal * promo.value) / 100) : promo.value;
    }
  }
  const finalTotal = Math.max(0, subtotal + deliveryFee - discountAmount);
  return { subtotal, deliveryFee, discountAmount, finalTotal };
}

function renderCheckoutSummary() {
  const listEl = document.getElementById('summaryCartItemsList');
  listEl.innerHTML = '';

  const totalCount = AppState.cart.reduce((s, i) => s + i.quantity, 0);
  document.getElementById('summaryItemsCount').textContent = `${totalCount} POZYCJI`;

  AppState.cart.forEach((item) => {
    const row = document.createElement('div');
    row.className = 'summary-item';

    const metaParts = [];
    if (item.sizeCm) metaParts.push(`Średnica: <strong>${item.sizeCm} cm</strong>`);
    if (item.doughName) metaParts.push(`Ciasto: ${item.doughName}`);
    if (item.sauces && item.sauces.length) metaParts.push(`Sosy: ${item.sauces.join(', ')}`);
    if (item.extras && item.extras.length) metaParts.push(`Dodatki: ${item.extras.join(', ')}`);

    row.innerHTML = `
      <img src="${item.image}" alt="${item.name}" loading="lazy" />
      <div class="summary-item-info">
        <div class="summary-item-top">
          <span>${item.name} ${item.sizeCm ? `<span style="color:var(--accent-lime); font-size:12px;">(${item.sizeCm} cm)</span>` : ''}</span>
          <span>${item.price * item.quantity} zł</span>
        </div>
        ${metaParts.length ? `<div class="summary-item-variant-meta">${metaParts.join(' · ')}</div>` : ''}
        <div class="qty-controls">
          <button type="button" data-dec="${item.cartItemId}">−</button>
          <span>${item.quantity}</span>
          <button type="button" data-inc="${item.cartItemId}">+</button>
        </div>
      </div>
    `;
    row.querySelector('[data-dec]').addEventListener('click', () => changeCartQuantity(item.cartItemId, -1));
    row.querySelector('[data-inc]').addEventListener('click', () => changeCartQuantity(item.cartItemId, 1));
    listEl.appendChild(row);
  });

  const { subtotal, deliveryFee, discountAmount, finalTotal } = calculateCheckoutTotals();
  const isDelivery = AppState.deliveryMethod === 'DELIVERY';

  document.getElementById('summarySubtotalVal').textContent = `${subtotal} zł`;
  document.getElementById('summaryDeliveryLabel').textContent = isDelivery ? 'Dostawa' : 'Odbiór';
  document.getElementById('summaryDeliveryVal').textContent = isDelivery ? `${deliveryFee} zł` : 'Gratis';

  const discountRow = document.getElementById('summaryDiscountRow');
  discountRow.classList.toggle('hidden', discountAmount === 0);
  document.getElementById('summaryDiscountVal').textContent = `-${discountAmount} zł`;
  document.getElementById('summaryTotalVal').textContent = `${finalTotal} zł`;
}

function populateCheckoutFromUser() {
  if (!AppState.user) return;
  document.getElementById('inputFullName').value = AppState.user.fullName || '';
  document.getElementById('inputPhone').value = AppState.user.phone || '';
  document.getElementById('inputEmail').value = AppState.user.email || '';
  if (AppState.user.street) document.getElementById('inputStreet').value = AppState.user.street;
  if (AppState.user.houseNumber) document.getElementById('inputHouseNumber').value = AppState.user.houseNumber;
  if (AppState.user.postalCode) document.getElementById('inputPostalCode').value = AppState.user.postalCode;
  if (AppState.user.city) document.getElementById('inputCity').value = AppState.user.city;
  verifyZoneByPostalCode();
}

function handleCheckoutFormSubmit(e) {
  e.preventDefault();
  if (AppState.cart.length === 0) {
    return alert('Twój koszyk jest pusty. Dodaj wybrane dania z menu.');
  }
  if (AppState.deliveryMethod === 'DELIVERY' && !AppState.currentZoneValid) {
    return alert('Twój adres znajduje się poza naszą strefą dostawy. Zmień adres na mapie lub wybierz Odbiór osobisty w Kartuzach.');
  }
  if (!document.getElementById('inputAcceptTerms').checked) {
    return alert('Zaakceptuj regulamin i politykę prywatności.');
  }

  const { finalTotal } = calculateCheckoutTotals();

  if (AppState.paymentMethod === 'BLIK' || AppState.paymentMethod === 'CARD_ONLINE') {
    const modal = document.getElementById('paymentGatewayModal');
    document.getElementById('modalPayAmount').textContent = `${finalTotal} zł`;
    const isBlik = AppState.paymentMethod === 'BLIK';
    document.getElementById('modalPayTitle').textContent = isBlik
      ? 'AUTORYZACJA PŁATNOŚCI BLIK'
      : 'PŁATNOŚĆ KARTĄ VISA / MASTERCARD';
    document.getElementById('modalPaySubtitle').textContent = isBlik
      ? 'Wprowadź 6-cyfrowy kod BLIK z aplikacji swojego banku.'
      : 'Zweryfikuj dane karty płatniczej (3D Secure).';
    document.getElementById('modalBlikSection').classList.toggle('hidden', !isBlik);
    document.getElementById('modalCardSection').classList.toggle('hidden', isBlik);
    modal.classList.remove('hidden');
  } else {
    completeAndSendOrder('PENDING (Płatność przy odbiorze)');
  }
}

async function completeAndSendOrder(paymentStatusText) {
  document.getElementById('paymentGatewayModal').classList.add('hidden');

  const { deliveryFee, finalTotal } = calculateCheckoutTotals();
  const orderNumber = 'BM-' + Math.floor(100000 + Math.random() * 900000);
  const fullName = document.getElementById('inputFullName').value.trim();
  const phone = document.getElementById('inputPhone').value.trim();
  const email = document.getElementById('inputEmail').value.trim();
  const street = document.getElementById('inputStreet').value.trim();
  const houseNumber = document.getElementById('inputHouseNumber').value.trim();
  const postalCode = document.getElementById('inputPostalCode').value.trim();
  const city = document.getElementById('inputCity').value.trim();

  const formattedItems = AppState.cart.map((item) => ({
    id: item.id,
    name: formatCartItemFullLabel(item),
    price: item.price,
    quantity: item.quantity
  }));

  const newOrder = {
    id: Date.now(),
    orderNumber,
    date: new Date().toLocaleString('pl-PL'),
    customerName: fullName,
    customerPhone: phone,
    customerEmail: email,
    deliveryMethod: AppState.deliveryMethod,
    address:
      AppState.deliveryMethod === 'DELIVERY'
        ? `${street} ${houseNumber}, ${postalCode} ${city} (${AppState.currentDistanceKm} km)`
        : 'Odbiór osobisty: ul. Kościuszki 19, 83-300 Kartuzy',
    paymentMethod: AppState.paymentMethod,
    paymentStatus: paymentStatusText,
    orderStatus: 'NEW',
    items: formattedItems,
    deliveryFee,
    total: finalTotal
  };

  AppState.orders.unshift(newOrder);
  AppState.cart = [];
  saveState();
  updateHeaderAndFloatingCart();
  renderCheckoutSummary();

  await triggerDiscordWebhook(newOrder, 'NOWE ZAMÓWIENIE');

  const banner = document.getElementById('orderConfirmationBanner');
  banner.classList.remove('hidden');
  banner.innerHTML = `
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <div>
        <span class="status-pill done">ZAMÓWIENIE WYSŁANE · POWIADOMIENIE DISCORD WYSŁANE</span>
        <h2 class="step-title" style="margin-top:8px; font-size:26px;">
          Dziękujemy! Zamówienie #${newOrder.orderNumber} (${newOrder.total} zł) przyjęte.
        </h2>
        <p style="font-size:13px; color:#dce2d8; margin-top:4px;">
          Pozycje: <strong>${formattedItems.map((i) => `${i.quantity}x ${i.name}`).join('; ')}</strong>
        </p>
      </div>
      <button type="button" class="util-btn active" id="goToHistoryAfterOrderBtn" style="padding:10px 18px;">
        ŚLEDŹ STATUS W HISTORII ZAMÓWIEŃ →
      </button>
    </div>
  `;
  document.getElementById('goToHistoryAfterOrderBtn').addEventListener('click', () => switchView('AUTH_HISTORY'));
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function renderAuthAndHistoryView() {
  const loggedBox = document.getElementById('loggedInProfileBox');
  if (AppState.user && AppState.jwtToken) {
    loggedBox.classList.remove('hidden');
    document.getElementById('loggedUserName').textContent = AppState.user.fullName;
    document.getElementById('loggedUserEmail').textContent = AppState.user.email;
    document.getElementById('jwtTokenPreview').textContent = AppState.jwtToken.slice(0, 68) + '...';
  } else {
    loggedBox.classList.add('hidden');
  }

  const listEl = document.getElementById('userOrdersHistoryList');
  if (AppState.orders.length === 0) {
    listEl.innerHTML = '<p style="font-size:13px; color:#45443e;">Nie masz jeszcze żadnych zamówień w historii.</p>';
    return;
  }

  const statusLabels = {
    NEW: { label: 'NOWE (PRZYJĘTE)', step: 1, cls: 'new' },
    PREPARING: { label: 'W PRZYGOTOWANIU (KUCHNIA)', step: 2, cls: 'prep' },
    IN_DELIVERY: { label: 'W DRODZE (KURIER)', step: 3, cls: 'prep' },
    READY_FOR_PICKUP: { label: 'GOTOWE DO ODBIORU', step: 3, cls: 'done' },
    COMPLETED: { label: 'ZREALIZOWANE', step: 4, cls: 'done' },
    CANCELLED: { label: 'ANULOWANE', step: 0, cls: 'new' }
  };

  listEl.innerHTML = AppState.orders
    .map((ord) => {
      const st = statusLabels[ord.orderStatus] || statusLabels.NEW;
      const itemsText = ord.items.map((i) => `${i.quantity}x ${i.name}`).join(', ');
      return `
        <div class="order-history-card">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
            <div>
              <strong style="font-size:16px;">Zamówienie #${ord.orderNumber}</strong>
              <span style="font-size:12px; color:#45443e; margin-left:6px;">${ord.date}</span>
            </div>
            <span class="status-pill ${st.cls}">${st.label}</span>
          </div>

          <div style="font-size:13px; margin:10px 0 6px;">
            <strong>Pozycje:</strong> ${itemsText}
          </div>
          <div style="font-size:12px; color:#2c2b26; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;">
            <span>${ord.address}</span>
            <strong style="color:#181b16; font-size:15px;">Razem: ${ord.total} zł (${ord.paymentMethod})</strong>
          </div>

          <div class="status-progress-steps" title="Pasek postępu realizacji zamówienia">
            <div class="status-step-bar ${st.step >= 1 ? 'active' : ''}"></div>
            <div class="status-step-bar ${st.step >= 2 ? 'active' : ''}"></div>
            <div class="status-step-bar ${st.step >= 3 ? 'active' : ''}"></div>
            <div class="status-step-bar ${st.step >= 4 ? 'active' : ''}"></div>
          </div>
        </div>
      `;
    })
    .join('');
}

function renderAdminPanel() {
  syncDiscordWebhookUrl(AppState.discordWebhookUrl);
  renderDiscordLogs();

  const ordersTbody = document.getElementById('adminOrdersTableBody');
  ordersTbody.innerHTML = AppState.orders
    .map(
      (ord) => `
      <tr>
        <td><strong>#${ord.orderNumber}</strong><br><span style="font-size:11px; color:#45443e;">${ord.date}</span></td>
        <td><strong>${ord.customerName}</strong> (${ord.customerPhone})<br><span style="font-size:11px; color:#45443e;">${ord.address}</span></td>
        <td>${ord.items.map((i) => `${i.quantity}x ${i.name}`).join('<br>')}</td>
        <td>${ord.paymentMethod}<br><span style="font-size:11px; color:#1f3608; font-weight:700;">${ord.paymentStatus}</span></td>
        <td><strong style="font-size:15px;">${ord.total} zł</strong></td>
        <td>
          <select data-admin-status-id="${ord.id}" style="padding:8px 10px; border-radius:8px; border:1px solid #ccc; font-size:12px; font-weight:700;">
            <option value="NEW" ${ord.orderStatus === 'NEW' ? 'selected' : ''}>NOWE (NEW)</option>
            <option value="PREPARING" ${ord.orderStatus === 'PREPARING' ? 'selected' : ''}>W PRZYGOTOWANIU (PREPARING)</option>
            <option value="IN_DELIVERY" ${ord.orderStatus === 'IN_DELIVERY' ? 'selected' : ''}>W DOSTAWIE (IN_DELIVERY)</option>
            <option value="READY_FOR_PICKUP" ${ord.orderStatus === 'READY_FOR_PICKUP' ? 'selected' : ''}>GOTOWE DO ODBIORU</option>
            <option value="COMPLETED" ${ord.orderStatus === 'COMPLETED' ? 'selected' : ''}>ZREALIZOWANE (COMPLETED)</option>
            <option value="CANCELLED" ${ord.orderStatus === 'CANCELLED' ? 'selected' : ''}>ANULOWANE (CANCELLED)</option>
          </select>
        </td>
      </tr>
    `
    )
    .join('');

  ordersTbody.querySelectorAll('[data-admin-status-id]').forEach((sel) => {
    sel.addEventListener('change', async () => {
      const id = Number(sel.getAttribute('data-admin-status-id'));
      const newStatus = sel.value;
      const ord = AppState.orders.find((o) => o.id === id);
      if (ord) {
        ord.orderStatus = newStatus;
        saveState();
        await triggerDiscordWebhook(ord, `ZMIANA STATUSU -> ${newStatus}`);
      }
    });
  });

  const menuTbody = document.getElementById('adminMenuTableBody');
  menuTbody.innerHTML = AppState.products
    .map(
      (prod) => `
      <tr>
        <td>
          <strong>${prod.name}</strong>
          ${prod.badge ? `<span style="font-size:10px; background:#eae6db; padding:2px 6px; border-radius:99px; margin-left:4px;">${prod.badge}</span>` : ''}
          <div style="font-size:11px; color:#45443e;">${prod.description}</div>
        </td>
        <td>${prod.category}</td>
        <td>
          <input type="number" data-price-id="${prod.id}" value="${prod.price}" style="width:74px; padding:6px 8px; border-radius:8px; border:1px solid #ccc; font-weight:800;" /> zł
        </td>
        <td>
          <button type="button" class="map-chip-btn" data-toggle-avail="${prod.id}" style="background:${prod.isAvailable ? '#eef6d0' : '#fde8e4'}; color:${prod.isAvailable ? '#28420b' : '#b32d15'};">
            ${prod.isAvailable ? '✓ Dostępne' : '✕ Wstrzymane'}
          </button>
        </td>
        <td>
          <button type="button" class="map-chip-btn" data-del-prod="${prod.id}" style="color:#8c1d0b;">Usuń</button>
        </td>
      </tr>
    `
    )
    .join('');

  menuTbody.querySelectorAll('[data-price-id]').forEach((inp) => {
    inp.addEventListener('change', () => {
      const id = Number(inp.getAttribute('data-price-id'));
      const newPrice = Number(inp.value);
      if (newPrice > 0) {
        const prod = AppState.products.find((p) => p.id === id);
        if (prod) {
          prod.price = newPrice;
          saveState();
          renderProductsGrid();
        }
      }
    });
  });

  menuTbody.querySelectorAll('[data-toggle-avail]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.getAttribute('data-toggle-avail'));
      const prod = AppState.products.find((p) => p.id === id);
      if (prod) {
        prod.isAvailable = !prod.isAvailable;
        saveState();
        renderAdminPanel();
        renderProductsGrid();
      }
    });
  });

  menuTbody.querySelectorAll('[data-del-prod]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.getAttribute('data-del-prod'));
      AppState.products = AppState.products.filter((p) => p.id !== id);
      saveState();
      renderAdminPanel();
      renderProductsGrid();
    });
  });
}

document.addEventListener('DOMContentLoaded', () => {
  renderCategories();
  renderProductsGrid();
  updateHeaderAndFloatingCart();
  renderCheckoutSummary();

  // Zdarzenia okna modalnego Konfiguratora Pizzy
  document.getElementById('closePizzaConfigBtn').addEventListener('click', () => {
    document.getElementById('pizzaConfiguratorModal').classList.add('hidden');
  });

  document.getElementById('cfgQtyDecBtn').addEventListener('click', () => {
    if (AppState.configModal.quantity > 1) {
      AppState.configModal.quantity -= 1;
      renderConfiguratorOptions();
    }
  });

  document.getElementById('cfgQtyIncBtn').addEventListener('click', () => {
    AppState.configModal.quantity += 1;
    renderConfiguratorOptions();
  });

  document.getElementById('cfgAddToCartConfirmBtn').addEventListener('click', confirmAddConfiguredPizzaToCart);

  // Przełącznik RWD
  const frameWrapper = document.getElementById('deviceFrameWrapper');
  document.querySelectorAll('[data-vp]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-vp');
      document.querySelectorAll('[data-vp]').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      frameWrapper.classList.remove('sim-tablet', 'sim-mobile');
      if (mode === 'tablet') frameWrapper.classList.add('sim-tablet');
      if (mode === 'mobile') frameWrapper.classList.add('sim-mobile');
      if (leafletMap) setTimeout(() => leafletMap.invalidateSize(), 320);
    });
  });

  // Nawigacja główna
  document.getElementById('logoBtn').addEventListener('click', () => switchView('MENU'));
  document.querySelectorAll('[data-nav="MENU"]').forEach((b) => b.addEventListener('click', () => switchView('MENU')));
  document.getElementById('navHistoryBtn').addEventListener('click', () => switchView('AUTH_HISTORY'));
  document.getElementById('navAdminBtn').addEventListener('click', () => switchView('ADMIN'));
  document.getElementById('quickAdminSwitchBtn').addEventListener('click', () => switchView('ADMIN'));
  document.getElementById('userProfileBtn').addEventListener('click', () => switchView('AUTH_HISTORY'));
  document.getElementById('cartHeaderBtn').addEventListener('click', () => switchView('CHECKOUT'));
  document.getElementById('mfcGoToCheckoutBtn').addEventListener('click', () => switchView('CHECKOUT'));

  document.getElementById('backToMenuFromCheckout').addEventListener('click', () => switchView('MENU'));
  document.getElementById('backToMenuFromUser').addEventListener('click', () => switchView('MENU'));
  document.getElementById('backToMenuFromAdmin').addEventListener('click', () => switchView('MENU'));

  document.getElementById('mobileMenuToggleBtn').addEventListener('click', () => {
    const drawer = document.getElementById('mobileNavDrawer');
    const isHidden = drawer.classList.toggle('hidden');
    document.getElementById('mobileMenuToggleBtn').textContent = isHidden ? '☰' : '✕';
  });
  document.querySelectorAll('[data-mobile-nav]').forEach((btn) => {
    btn.addEventListener('click', () => switchView(btn.getAttribute('data-mobile-nav')));
  });

  document.getElementById('optDeliveryBtn').addEventListener('click', () => setDeliveryMethod('DELIVERY'));
  document.getElementById('optPickupBtn').addEventListener('click', () => setDeliveryMethod('PICKUP'));

  document.getElementById('inputPostalCode').addEventListener('input', verifyZoneByPostalCode);
  document.querySelectorAll('[data-zone-preset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById('inputPostalCode').value = btn.getAttribute('data-zone-preset');
      verifyZoneByPostalCode();
    });
  });

  document.querySelectorAll('[data-payment]').forEach((card) => {
    card.addEventListener('click', () => {
      AppState.paymentMethod = card.getAttribute('data-payment');
      document.querySelectorAll('[data-payment]').forEach((c) => c.classList.remove('active'));
      card.classList.add('active');
    });
  });

  document.getElementById('applyPromoBtn').addEventListener('click', () => {
    const code = document.getElementById('inputPromoCode').value.trim().toUpperCase();
    if (INITIAL_DATA.promoCodes[code]) {
      AppState.appliedPromo = code;
      renderCheckoutSummary();
      alert(`Kod rabatowy ${code} aktywowany!`);
    } else {
      alert('Nieprawidłowy kod. Wypróbuj: BEMOL10 lub PIZZA5');
    }
  });

  document.getElementById('checkoutForm').addEventListener('submit', handleCheckoutFormSubmit);

  document.getElementById('generateRandomBlikBtn').addEventListener('click', () => {
    document.getElementById('modalBlikInput').value = Math.floor(100000 + Math.random() * 900000).toString();
  });

  document.getElementById('confirmModalPaymentBtn').addEventListener('click', () => {
    if (AppState.paymentMethod === 'BLIK') {
      const blik = document.getElementById('modalBlikInput').value.trim();
      if (!/^\d{6}$/.test(blik)) return alert('Wprowadź dokładnie 6 cyfr kodu BLIK.');
      completeAndSendOrder(`OPŁACONE BLIK (Kod ***${blik.slice(3)})`);
    } else {
      completeAndSendOrder('OPŁACONE KARTĄ (3D Secure Visa)');
    }
  });

  document.getElementById('cancelModalPaymentBtn').addEventListener('click', () => {
    document.getElementById('paymentGatewayModal').classList.add('hidden');
  });

  document.getElementById('tabLoginBtn').addEventListener('click', () => {
    document.getElementById('loginForm').classList.remove('hidden');
    document.getElementById('registerForm').classList.add('hidden');
    document.getElementById('tabLoginBtn').style.background = '#1d231a';
    document.getElementById('tabLoginBtn').style.color = '#fff';
    document.getElementById('tabRegisterBtn').style.background = '#eae6db';
    document.getElementById('tabRegisterBtn').style.color = '#181b16';
  });

  document.getElementById('tabRegisterBtn').addEventListener('click', () => {
    document.getElementById('loginForm').classList.add('hidden');
    document.getElementById('registerForm').classList.remove('hidden');
    document.getElementById('tabRegisterBtn').style.background = '#1d231a';
    document.getElementById('tabRegisterBtn').style.color = '#fff';
    document.getElementById('tabLoginBtn').style.background = '#eae6db';
    document.getElementById('tabLoginBtn').style.color = '#181b16';
  });

  document.getElementById('loginForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const email = document.getElementById('loginEmail').value.trim();
    const userObj = {
      fullName: email.includes('admin') ? 'Administrator BEMOL' : 'Jan Kowalski',
      email,
      phone: '+48 500 600 700',
      street: 'ul. Jeziorna',
      houseNumber: '12 / 4',
      postalCode: '83-300',
      city: 'Kartuzy'
    };
    AppState.user = userObj;
    AppState.jwtToken = createSimulatedJWT(userObj);
    saveState();
    updateHeaderAndFloatingCart();
    renderAuthAndHistoryView();
    alert('Zalogowano pomyślnie! Wygenerowano token JWT.');
  });

  document.getElementById('registerForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const userObj = {
      fullName: document.getElementById('regFullName').value.trim(),
      phone: document.getElementById('regPhone').value.trim(),
      email: document.getElementById('regEmail').value.trim(),
      street: document.getElementById('regStreet').value.trim(),
      houseNumber: document.getElementById('regHouseNumber').value.trim(),
      postalCode: document.getElementById('regPostalCode').value.trim(),
      city: document.getElementById('regCity').value.trim()
    };
    AppState.user = userObj;
    AppState.jwtToken = createSimulatedJWT(userObj);
    saveState();
    updateHeaderAndFloatingCart();
    renderAuthAndHistoryView();
    alert('Konto utworzone i zalogowane (JWT)!');
  });

  document.getElementById('logoutJwtBtn').addEventListener('click', () => {
    AppState.user = null;
    AppState.jwtToken = null;
    saveState();
    updateHeaderAndFloatingCart();
    renderAuthAndHistoryView();
  });

  document.getElementById('adminAddProductForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const newProd = {
      id: Date.now(),
      category: document.getElementById('adminProdCategory').value,
      name: document.getElementById('adminProdName').value.trim(),
      price: Number(document.getElementById('adminProdPrice').value),
      badge: document.getElementById('adminProdBadge').value.trim(),
      description: document.getElementById('adminProdDesc').value.trim(),
      isAvailable: true,
      image: 'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=600&q=80'
    };
    AppState.products.unshift(newProd);
    saveState();
    renderAdminPanel();
    renderProductsGrid();
    e.target.reset();
    alert(`Dodano "${newProd.name}" do menu!`);
  });

  // Inicjalizacja stanu i pól Discord Webhook przy starcie
  syncDiscordWebhookUrl(AppState.discordWebhookUrl);

  // Natychmiastowy zapis przy wpisywaniu/wklejaniu w Panelu Admina
  const adminWebhookInput = document.getElementById('inputDiscordWebhookUrl');
  if (adminWebhookInput) {
    adminWebhookInput.addEventListener('input', (e) => syncDiscordWebhookUrl(e.target.value));
    adminWebhookInput.addEventListener('change', (e) => syncDiscordWebhookUrl(e.target.value));
  }

  // Natychmiastowy zapis przy wpisywaniu/wklejaniu bezpośrednio w Koszyku
  const checkoutWebhookInput = document.getElementById('checkoutDiscordWebhookInput');
  if (checkoutWebhookInput) {
    checkoutWebhookInput.addEventListener('input', (e) => syncDiscordWebhookUrl(e.target.value));
    checkoutWebhookInput.addEventListener('change', (e) => syncDiscordWebhookUrl(e.target.value));
  }

  // Przycisk "ZAPISZ URL" w Panelu Admina
  const saveWebhookBtn = document.getElementById('saveDiscordWebhookBtn');
  if (saveWebhookBtn) {
    saveWebhookBtn.addEventListener('click', () => {
      const val = document.getElementById('inputDiscordWebhookUrl').value;
      syncDiscordWebhookUrl(val);
      if (isValidDiscordWebhookUrl(val)) {
        alert('✅ Adres Discord Webhook został zapisany i aktywowany!');
      } else {
        alert('⚠️ Wklej prawidłowy adres URL Webhooka Discord (zaczynający się od https://discord.com/api/webhooks/...).');
      }
    });
  }

  // Wspólna funkcja testująca wysyłkę na żywo na serwer Discord
  async function handleManualDiscordTest(sourceInputId) {
    const rawVal = document.getElementById(sourceInputId)?.value || AppState.discordWebhookUrl;
    syncDiscordWebhookUrl(rawVal);

    if (!rawVal) {
      return alert('⚠️ Najpierw wklej adres URL Webhooka ze swojego kanału Discord (Ustawienia kanału -> Integracje -> Webhooki -> Kopiuj adres URL webhooka).');
    }
    if (!isValidDiscordWebhookUrl(rawVal)) {
      return alert('❌ Nieprawidłowy format linku! Poprawny adres wygląda tak:\nhttps://discord.com/api/webhooks/123456789/abcDEF...');
    }

    const sampleOrder = AppState.orders[0] || {
      id: 9999,
      orderNumber: 'BM-TEST01',
      customerName: 'Jan Kowalski (Test)',
      customerPhone: '+48 500 600 700',
      deliveryMethod: 'DELIVERY',
      address: 'ul. Kościuszki 19, 83-300 Kartuzy',
      paymentMethod: 'BLIK',
      paymentStatus: 'PAID',
      orderStatus: 'NEW',
      items: [{ name: 'Diavola (32 cm · Klasyczne Włoskie · Sos czosnkowy)', price: 43, quantity: 1 }],
      total: 51
    };

    const res = await triggerDiscordWebhook(sampleOrder, 'TEST POŁĄCZENIA DISCORD WEBHOOK');
    alert(res.statusText);
  }

  document.getElementById('testDiscordWebhookBtn').addEventListener('click', () => {
    handleManualDiscordTest('inputDiscordWebhookUrl');
  });

  const checkoutTestBtn = document.getElementById('checkoutTestDiscordBtn');
  if (checkoutTestBtn) {
    checkoutTestBtn.addEventListener('click', () => {
      handleManualDiscordTest('checkoutDiscordWebhookInput');
    });
  }
});

</script>
</body>
</html>

User-agent: *
Allow: /
Disallow: /api/admin/

Sitemap: http://localhost:4000/sitemap.xml

// ============================================================================
// PLIK: start-local-server.js (Wersja v8)
// Lekki serwer HTTP (0 zależności, czysty Node.js) z wbudowanym przekaźnikiem
// POST /api/discord-proxy wysyłającym powiadomienia bezpośrednio do Discorda
// Uruchomienie: node start-local-server.js -> Otwórz http://localhost:3000
// ============================================================================

const http = require('http');
const https = require('https');
const fs = require('fs');
const path = require('path');
const { URL } = require('url');

const PORT = 3000;
const PUBLIC_DIR = path.join(__dirname, 'frontend');

const MIME_TYPES = {
  '.html': 'text/html; charset=utf-8',
  '.css': 'text/css; charset=utf-8',
  '.js': 'application/javascript; charset=utf-8',
  '.txt': 'text/plain; charset=utf-8',
  '.xml': 'application/xml; charset=utf-8',
  '.json': 'application/json; charset=utf-8',
  '.png': 'image/png',
  '.jpg': 'image/jpeg',
  '.svg': 'image/svg+xml'
};

function forwardToDiscord(webhookUrl, payloadObj) {
  return new Promise((resolve) => {
    try {
      const target = new URL(webhookUrl.trim());
      target.searchParams.set('wait', 'true');
      const bodyStr = JSON.stringify(payloadObj);

      const req = https.request(
        {
          hostname: target.hostname,
          port: 443,
          path: target.pathname + target.search,
          method: 'POST',
          headers: {
            'Content-Type': 'application/json; charset=utf-8',
            'Content-Length': Buffer.byteLength(bodyStr, 'utf8'),
            'User-Agent': 'BemolLocalServerProxy/9.0'
          }
        },
        (res) => {
          let data = '';
          res.on('data', (c) => { data += c; });
          res.on('end', () => {
            resolve({
              ok: res.statusCode >= 200 && res.statusCode < 300,
              httpStatus: res.statusCode,
              details: data
            });
          });
        }
      );
      req.on('error', (e) => resolve({ ok: false, httpStatus: 500, details: e.message }));
      req.write(bodyStr);
      req.end();
    } catch (err) {
      resolve({ ok: false, httpStatus: 400, details: err.message });
    }
  });
}

http.createServer((req, res) => {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') {
    res.writeHead(204);
    return res.end();
  }

  const cleanUrl = req.url.split('?')[0];

  // Wbudowany przekaźnik POST /api/discord-proxy (omija CORS przeglądarki)
  if (req.method === 'POST' && cleanUrl === '/api/discord-proxy') {
    let rawBody = '';
    req.on('data', (chunk) => { rawBody += chunk; });
    req.on('end', async () => {
      try {
        const parsed = JSON.parse(rawBody || '{}');
        const result = await forwardToDiscord(parsed.webhookUrl, parsed.payload);
        res.writeHead(result.ok ? 200 : (result.httpStatus || 500), { 'Content-Type': 'application/json; charset=utf-8' });
        return res.end(JSON.stringify(result));
      } catch (e) {
        res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
        return res.end(JSON.stringify({ ok: false, details: e.message }));
      }
    });
    return;
  }

  if (cleanUrl === '/robots.txt') {
    res.writeHead(200, { 'Content-Type': 'text/plain; charset=utf-8' });
    return res.end('User-agent: *\nAllow: /\nDisallow: /api/admin/\n\nSitemap: http://localhost:3000/sitemap.xml\n');
  }

  if (cleanUrl === '/sitemap.xml') {
    res.writeHead(200, { 'Content-Type': 'application/xml; charset=utf-8' });
    return res.end('<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"><url><loc>http://localhost:3000/</loc></url></urlset>');
  }

  let filePath = path.join(PUBLIC_DIR, cleanUrl === '/' ? 'index-v10.html' : cleanUrl);
  if (!fs.existsSync(filePath)) {
    filePath = path.join(__dirname, cleanUrl === '/' ? 'bemol_kompletny_system-v10.html' : cleanUrl);
  }

  fs.readFile(filePath, (err, content) => {
    if (err) {
      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
      return res.end('404 Not Found');
    }
    const ext = path.extname(filePath).toLowerCase();
    res.writeHead(200, { 'Content-Type': MIME_TYPES[ext] || 'application/octet-stream' });
    res.end(content);
  });
}).listen(PORT, () => {
  console.log(`Serwer HTTP v8 (z Proxy Discord Webhook) działa na: http://localhost:${PORT}`);
});
