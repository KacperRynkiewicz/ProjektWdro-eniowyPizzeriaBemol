.device-frame-wrapper.sim-mobile .config-modal-header img { width: 48px; height: 48px; }
.device-frame-wrapper.sim-mobile .config-modal-body { padding: 12px; gap: 12px; }
.device-frame-wrapper.sim-mobile .config-section-block { padding: 12px; }
.device-frame-wrapper.sim-mobile .config-modal-footer { padding: 12px; gap: 8px; flex-direction: column; align-items: stretch; }
